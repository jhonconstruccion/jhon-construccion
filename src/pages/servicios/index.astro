---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/site.js";
---
<BaseLayout title="Servicios de construcción | M&M Construcciones" description="Conoce los servicios de M&M Construcciones: construcción general, ampliaciones, remodelaciones, obras comerciales, terminaciones, mantención y reparaciones.">
  <section class="page-hero page-hero-small">
    <div class="page-hero-image" style={`background-image:url('/images/portfolio/comercial-estructura-pasillo.jpg')`}></div><div class="page-hero-overlay"></div>
    <div class="container page-hero-content"><span class="eyebrow eyebrow-light">NUESTROS SERVICIOS</span><h1>Soluciones para cada <em>etapa de tu proyecto.</em></h1><p>Desde una reparación puntual hasta trabajos de construcción y adecuación de espacios residenciales y comerciales.</p></div>
  </section>
  <section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">SEIS ÁREAS DE TRABAJO</span><h2>¿Qué necesitas <em>resolver?</em></h2></div><p>Revisa nuestras áreas de servicio y cuéntanos qué tipo de trabajo tienes en mente.</p></div><div class="service-list-grid">{services.map((service) => <a class="service-list-card" href={`/servicios/${service.slug}/`}><img src={service.image} alt={service.imageAlt} loading="lazy"/><div class="service-list-content"><span>{service.number} / SERVICIO</span><h3>{service.title}</h3><p>{service.summary}</p><b>Conocer servicio ↗</b></div></a>)}</div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">CUÉNTANOS QUÉ NECESITAS</span><h2>Evaluemos juntos <em>tu proyecto.</em></h2></div><a class="button button-primary" href="/contacto/">Solicitar cotización ↗</a></div></section>
</BaseLayout>
