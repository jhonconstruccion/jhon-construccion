---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/site.js";
---
<BaseLayout title="Proyectos | M&M Construcciones en General" description="Galería de trabajos y procesos de M&M Construcciones en General: proyectos residenciales, comerciales, ampliaciones y remodelaciones.">
  <section class="page-hero page-hero-small"><div class="page-hero-image" style={`background-image:url('/images/portfolio/portfolio-obra-nueva-vista-general.jpg')`}></div><div class="page-hero-overlay"></div><div class="container page-hero-content"><span class="eyebrow eyebrow-light">PORTAFOLIO</span><h1>Proyectos que comienzan <em>con una idea.</em></h1><p>Una muestra de trabajos residenciales, comerciales y de mejoramiento de espacios.</p></div></section>
  <section class="section"><div class="container"><div class="portfolio-notice"><span class="notice-icon">✓</span><div><strong>Trabajos y procesos de M&M</strong><p>Esta galería reúne registros fotográficos de obras, ampliaciones, remodelaciones y espacios comerciales. Algunas imágenes muestran etapas de ejecución y otras trabajos con sus terminaciones.</p></div></div><div class="project-grid project-grid-large">{projects.map((project) => <article class="project-card"><div class="project-image"><img src={project.image} alt={project.alt} loading="lazy"/></div><div class="project-card-meta"><span>{project.category}</span><span>↗</span></div><h3>{project.title}</h3><p class="project-description">{project.description}</p></article>)}</div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><span class="eyebrow eyebrow-light">TU PROYECTO PUEDE SER EL SIGUIENTE</span><h2>Cuéntanos qué necesitas <em>desarrollar.</em></h2></div><a class="button button-primary" href="/contacto/">Solicitar cotización ↗</a></div></section>
</BaseLayout>
