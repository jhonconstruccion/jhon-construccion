---
import BaseLayout from "../layouts/BaseLayout.astro";
import { company, services, projects } from "../data/site.js";
---
<BaseLayout>
  <section class="hero">
    <div class="hero-image" role="img" aria-label="Pérgola de madera y quincho junto a piscina"></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <span class="eyebrow eyebrow-light"><span class="eyebrow-line"></span> M&M CONSTRUCCIONES EN GENERAL</span>
      <h1>Construimos tus proyectos con <em>calidad y confianza.</em></h1>
      <p>Construcción, ampliaciones, remodelaciones, obras civiles y reparación y mantención de piscinas para hogares y empresas.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/contacto/">Solicitar cotización <span>↗</span></a>
        <a class="button button-ghost" href="/servicios/">Conocer servicios</a>
      </div>
      <div class="hero-proof">
        <span><strong>10+</strong> años de experiencia en el rubro</span>
        <span class="proof-divider"></span>
        <span>Atención residencial y comercial</span>
      </div>
    </div>
    <div class="hero-index">01 / CONSTRUIMOS CON PROPÓSITO</div>
  </section>

  <section class="trust-strip">
    <div class="container trust-grid">
      <div><span class="trust-number">10+</span><span>años de experiencia en el rubro</span></div>
      <div><span class="trust-number">07</span><span>áreas de servicio</span></div>
      <div><span class="trust-number">RM +</span><span>otras regiones según proyecto</span></div>
      <div><span class="trust-number">M&M</span><span>soluciones para hogares y empresas</span></div>
    </div>
  </section>

  <section class="section section-intro">
    <div class="container intro-grid">
      <div>
        <span class="eyebrow">SOLUCIONES CONSTRUCTIVAS</span>
        <h2>Un proyecto bien hecho comienza con <em>una buena decisión.</em></h2>
      </div>
      <div class="intro-copy">
        <p>En M&M Construcciones en General abordamos cada proyecto desde sus necesidades reales. Escuchamos, evaluamos y coordinamos soluciones para espacios residenciales y comerciales.</p>
        <p>Trabajamos con más de 10 años de experiencia en el rubro y atendemos proyectos en la Región Metropolitana y otras regiones, de acuerdo con su alcance.</p>
        <a class="text-link" href="/nosotros/">Conoce nuestra forma de trabajar <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section audience-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">A QUIÉN ACOMPAÑAMOS</span><h2>Soluciones para cada <em>tipo de proyecto.</em></h2></div>
        <p>Dos caminos, una misma forma de trabajar: compromiso, comunicación y atención a los detalles.</p>
      </div>
      <div class="audience-grid">
        <a class="audience-card" href="/servicios/ampliaciones/">
          <img src="/images/portfolio/portfolio-ampliacion-segundo-piso.jpg" alt="Ampliación residencial de segundo piso en ejecución" loading="lazy" />
          <div class="audience-card-overlay"></div>
          <div class="audience-card-content"><span>01 / RESIDENCIAL</span><h3>Tu hogar, pensado para crecer.</h3><p>Construcción, ampliaciones y remodelaciones para viviendas.</p><b>Explorar soluciones ↗</b></div>
        </a>
        <a class="audience-card" href="/servicios/obras-comerciales/">
          <img src="/images/portfolio/portfolio-edificio-comercial.jpg" alt="Edificio de varios niveles con fachada vidriada" loading="lazy" />
          <div class="audience-card-overlay"></div>
          <div class="audience-card-content"><span>02 / EMPRESAS Y COMERCIOS</span><h3>Espacios que impulsan tu negocio.</h3><p>Obras, adecuaciones, terminaciones y mantención comercial.</p><b>Explorar soluciones ↗</b></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">QUÉ HACEMOS</span><h2>Servicios para llevar tus ideas <em>a la realidad.</em></h2></div>
        <a class="text-link desktop-link" href="/servicios/">Ver todos los servicios <span>→</span></a>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <a class="service-card" href={`/servicios/${service.slug}/`}>
            <span class="service-number">{service.number}</span>
            <div class="service-card-icon">{service.number}</div>
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
            <span class="service-arrow">↗</span>
          </a>
        ))}
      </div>
      <a class="text-link mobile-link" href="/servicios/">Ver todos los servicios <span>→</span></a>
    </div>
  </section>

  <section class="section pool-home-feature">
    <div class="container pool-home-grid">
      <div class="pool-home-copy">
        <span class="eyebrow">SERVICIO · PISCINAS</span>
        <h2>Reparación y mantención de piscinas para <em>volver a disfrutarlas.</em></h2>
        <p>Evaluamos el estado de cada piscina y realizamos trabajos de reparación y mantención según las necesidades de sus superficies y terminaciones.</p>
        <a class="button button-primary" href="/servicios/reparacion-y-mantencion-de-piscinas/">Conocer el servicio ↗</a>
      </div>
      <div class="pool-home-gallery">
        <figure>
          <img src="/images/portfolio/piscina-proceso-reparacion.jpg" alt="Piscina durante los trabajos de reparación y mantención" loading="lazy" />
          <figcaption><span>01 / PROCESO</span>Durante los trabajos</figcaption>
        </figure>
        <figure>
          <img src="/images/portfolio/piscina-resultado-terminado.jpg" alt="Piscina terminada después de los trabajos de reparación y mantención" loading="lazy" />
          <figcaption><span>02 / RESULTADO</span>Piscina terminada</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="process-section">
    <div class="container process-grid">
      <div class="process-heading">
        <span class="eyebrow eyebrow-light">UNA FORMA CLARA DE AVANZAR</span>
        <h2>De la primera conversación <em>al proyecto.</em></h2>
        <p>Cada trabajo es distinto. Por eso comenzamos entendiendo qué necesitas y cuál es el alcance real.</p>
        <a class="button button-outline-light" href="/contacto/">Conversemos sobre tu proyecto <span>↗</span></a>
      </div>
      <div class="process-steps">
        <div class="process-step"><span>01</span><div><h3>Nos cuentas tu idea</h3><p>Recibimos los antecedentes y entendemos tu necesidad.</p></div></div>
        <div class="process-step"><span>02</span><div><h3>Evaluamos el proyecto</h3><p>Podemos revisar fotografías y antecedentes o coordinar una visita.</p></div></div>
        <div class="process-step"><span>03</span><div><h3>Definimos la propuesta</h3><p>Conversamos sobre alcance, trabajos y próximos pasos.</p></div></div>
        <div class="process-step"><span>04</span><div><h3>Coordinamos el trabajo</h3><p>Avanzamos según lo acordado para cada proyecto.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">PORTAFOLIO</span><h2>Los detalles hacen <em>la diferencia.</em></h2></div>
        <a class="text-link desktop-link" href="/proyectos/">Ver portafolio <span>→</span></a>
      </div>
      <div class="project-grid">
        {projects.slice(0, 3).map((project) => (
          <a class="project-card" href="/proyectos/">
            <div class="project-image"><img src={project.image} alt={project.alt} loading="lazy" /></div>
            <div class="project-card-meta"><span>{project.category}</span><span>↗</span></div>
            <h3>{project.title}</h3>
          </a>
        ))}
      </div>
      <p class="fine-print">Una selección de fotografías de trabajos y procesos de M&M Construcciones en General.</p>
      <a class="text-link mobile-link" href="/proyectos/">Ver portafolio <span>→</span></a>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <div><span class="eyebrow eyebrow-light">HABLEMOS DE TU PROYECTO</span><h2>El próximo proyecto importante <em>puede comenzar aquí.</em></h2></div>
      <a class="button button-primary" href="/contacto/">Solicitar cotización <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
